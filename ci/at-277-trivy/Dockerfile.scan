FROM nginx:1.31.9-alpine3.24@sha256:fb4658584bd9a916ffb6f6e365f97c25cfdb2923801f551ea08356e695f14ff7
RUN apk upgrade --no-cache libxml2
COPY nginx.conf /etc/nginx/nginx.conf
COPY browser/ /usr/share/nginx/html/
RUN chmod 644 /etc/nginx/nginx.conf && chmod -R a+rX /usr/share/nginx/html
USER nginx
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
