{
  "name": "estimate-app",
  "version": "0.1.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "ng test --watch=false",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check && node scripts/contract-test.mjs",
    "openspec:check": "openspec validate --specs --strict && openspec validate --archived --strict",
    "check": "npm run lint && npm run typecheck && npm run test && npm run contract:check && npm run policy:check && npm run openspec:check && npm run build",
    "policy:check": "node scripts/policy-test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "rxjs": "7.8.0",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@fission-ai/openspec": "2.2.0",
    "angular-eslint": "22.8.0",
    "eslint": "9.39.1",
    "jsdom": "31.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "5.1.2"
  }
}
